# ============================================================
# 青禾校园点餐 —— 生产环境变量
# 复制为 .env 后填写真实值，再执行 ./deploy.sh
#   cp .env.production.example .env && chmod 600 .env
# .env 含全部密钥，绝对不要提交到 Git、不要外传。
# ============================================================

# ---------- 站点 ----------
# Nginx 对外域名（已备案的域名，不要带 https://）。没有域名时先填公网 IP。
SERVER_NAME=your-domain.example.com

# ---------- MySQL ----------
# 建议用 openssl rand -hex 24 生成
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=moxuany
MYSQL_USER=moxuany
MYSQL_PASSWORD=

# ---------- Redis ----------
# 只在 127.0.0.1 监听，密码可留空；留空表示不设密码
REDIS_PASSWORD=

# ---------- 后端 ----------
# 必须 ≥32 位随机字符，否则 JWT 可被离线爆破
# 生成：openssl rand -hex 32
TOKEN_SECRET=

# 演示模式。生产环境必须为 false！
# 关闭后网站仍可使用用户名+密码+邀请码注册登录，微信小程序仍可使用微信登录。
FOOD_DEMO_ENABLED=false

# 网站账号登录（用户名/密码/验证码）。生产保持 true。
FOOD_WEB_LOGIN_ENABLED=true

# 模拟支付开关。项目尚未接入真实微信支付，必须保持 true；
# 置为 false 后用户下单将无法完成支付。
FOOD_MOCK_PAYMENT_ENABLED=true

# ---------- 微信小程序 ----------
WECHAT_APPID=
# AppSecret 只放服务端，绝不能进小程序代码
WECHAT_SECRET=
FOOD_SUBSCRIPTIONS_ENABLED=false
FOOD_MESSAGE_ENVIRONMENT=formal

# ---------- 百度地图逆地理编码（可选）----------
# 服务端 AK，需开通逆地理编码并配置服务器 IP 白名单。留空则不调用第三方。
BAIDU_MAP_AK=
