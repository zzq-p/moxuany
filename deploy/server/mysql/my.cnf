# ============================================================
# MySQL 8.4 —— 2 核 2G 小内存实例专用调优
# 挂载到容器 /etc/mysql/conf.d/99-moxuany.cnf
# 目标：把 MySQL 常驻内存压到 400MB 以内
# ============================================================
[mysqld]
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci
default-time-zone               = '+08:00'

# ---- 内存相关（这里省的是最大头）----
# InnoDB 缓冲池：默认 128M，2G 机器上不要超过 128M。
# 数据量长大后（单表千万级）再考虑加到 256M~384M。
innodb_buffer_pool_size         = 128M
# 性能监控表默认占用 150~200MB，本项目不需要，直接关掉。
performance_schema              = OFF

# ---- 连接与线程 ----
# 后端 Druid 最大 40 连接，100 足够；
# 每个连接都会吃内存，不要照搬默认的 151。
max_connections                 = 100
thread_cache_size               = 16

# ---- 各类排序/连接缓冲：按下限给，避免 100 个连接各占一大块 ----
sort_buffer_size                = 512K
join_buffer_size                = 512K
read_buffer_size                = 256K
read_rnd_buffer_size            = 512K
tmp_table_size                  = 16M
max_heap_table_size             = 16M

# ---- 表缓存 ----
table_open_cache                = 256
table_definition_cache          = 400

# ---- 刷盘策略 ----
# 保持默认的 1（每次事务提交都刷盘）。这是订单和资金数据，不要为了性能改成 2。
innodb_flush_log_at_trx_commit  = 1
innodb_flush_method             = O_DIRECT
sync_binlog                     = 1

# ---- 慢查询（便于上线后定位问题）----
slow_query_log                  = 1
long_query_time                 = 1
slow_query_log_file             = /var/lib/mysql/slow.log

# MySQL 8.4 的 X Plugin 默认监听 33060 端口，本项目用不到。
# 如果启动失败，把下面这行注释掉即可（不同镜像版本参数名略有差异）。
mysqlx                          = OFF

[client]
default-character-set = utf8mb4
