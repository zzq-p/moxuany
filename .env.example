MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-app-password
TOKEN_SECRET=replace-with-at-least-32-random-characters

# Optional: Baidu server-side AK with reverse geocoding enabled.
BAIDU_MAP_AK=

# Optional WeChat subscriptions. Keep secrets on the backend only.
WECHAT_APPID=
WECHAT_SECRET=
FOOD_SUBSCRIPTIONS_ENABLED=false
FOOD_MESSAGE_ENVIRONMENT=trial
